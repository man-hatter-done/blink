# Flask application settings
SECRET_KEY=your_secure_random_key_here
DEBUG=false
PORT=5000
HOST=0.0.0.0

# API Key for client authentication (this should match what's in the iOS app)
# The Swift client uses "B2D4G5" as the hardcoded API key
API_KEY=B2D4G5

# Session settings
SESSION_TIMEOUT=3600  # 1 hour in seconds
COMMAND_TIMEOUT=30    # 30 seconds

# Terminal settings
DEFAULT_SHELL=/bin/bash
DEFAULT_TERM=xterm-256color
DEFAULT_ROWS=24
DEFAULT_COLS=80

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
